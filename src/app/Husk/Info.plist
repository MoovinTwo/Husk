<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- These four are NOT optional: without CFBundleIdentifier and
	     CFBundleExecutable the bundle will not install at all. Xcode only injects
	     them when GENERATE_INFOPLIST_FILE is on, which it is not when a custom
	     INFOPLIST_FILE is supplied -- so they are declared here and filled in by
	     INFOPLIST_EXPAND_BUILD_SETTINGS (on by default). -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<!-- Where the guest is downloaded from: owner/name of a GitHub repository,
	     set as HUSK_RELEASES_REPO in project.yml. -->
	<key>HuskReleasesRepo</key>
	<string>$(HUSK_RELEASES_REPO)</string>

	<key>CFBundleDisplayName</key>
	<string>Husk</string>
	<key>CFBundleShortVersionString</key>
	<string>0.6.1</string>
	<key>CFBundleVersion</key>
	<string>9</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- canOpenURL("stikjit://") returns false unless the scheme is declared here. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>stikjit</string>
		<string>stikdebug</string>
		<string>stosdebug</string>
		<string>apple-magnifier</string>
		<string>localdevvpn</string>
	</array>
	<!-- LocalDevVPN returns to husk:// once connected (JITSetup.swift). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>husk</string>
			</array>
		</dict>
	</array>
	<!-- On-device pairing (JITPairing.swift): Husk advertises itself as a
	     pairable computer, and keeps running while the user pairs from Settings. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_remotepairing-pairable-host._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Husk uses the local network to pair with this iPhone for JIT, without a computer.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).pairing.*</string>
	</array>
	<!-- Android games may talk plain http as well as https; iOS refuses plain http unless told otherwise. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- Phase 3 drops APKs in here. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
